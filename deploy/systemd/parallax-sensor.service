[Unit]
Description=Parallax Packet Metadata Sensor
After=local-fs.target

[Service]
Type=simple

User=parallax-sensor
Group=parallax

Environment=PATH=/opt/parallax/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/usr/bin/env parallax-sensor --socket /run/parallax/sensor.sock

RuntimeDirectory=parallax
RuntimeDirectoryMode=0750
UMask=0117

KillSignal=SIGINT
TimeoutStopSec=5s
Restart=on-failure
RestartSec=1s

AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes

RestrictAddressFamilies=AF_UNIX AF_PACKET
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/parallax
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
